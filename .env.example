# Base URL used for canonical links, Open Graph, sitemap.xml, robots.txt, and
# JSON-LD. Wired through `src/lib/constants/index.ts`.
# Production currently runs on this workers.dev preview URL. When a custom
# domain is deployed, set this to it and rebuild.
NEXT_PUBLIC_SITE_URL=https://booming-dawn.abdullrahman-moh1993.workers.dev

# Turnstile client sitekey. Leave unset in production (the real sitekey is the
# default in src/lib/security/turnstile-sitekey.ts). Set to Cloudflare's TEST
# key (1x00000000000000000000AA) in .env.development.local so dev servers
# auto-pass the widget. IMPORTANT: do not put this in .env.local — it is loaded
# by production builds too and would ship the test key to production (the live
# site verify rejects the dummy tokens it produces, breaking checkout).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Google Sheets/email notification webhook. Production values are set with
# `wrangler secret put` (never commit them); local dev uses a .dev.vars file.
# ORDER_WEBHOOK_URL=https://script.google.com/macros/s/XXXXX/exec
# ORDER_WEBHOOK_TOKEN=replace-with-token

# Turnstile server-side verification. Production values are set with
# `wrangler secret put` (never commit them); while unset the server skips
# verification (open gate) — used by local dev and CI previews.
# TURNSTILE_SECRET=0x4AAAAAAA...            (siteverify client secret)
# TURNSTILE_HOSTNAMES=booming-dawn.abdullrahman-moh1993.workers.dev