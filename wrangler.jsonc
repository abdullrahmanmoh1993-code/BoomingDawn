{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "booming-dawn",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "ORDER_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "SUBSCRIBE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "booming-dawn",
      "database_id": "16f62be8-301d-4aad-b083-32dced21885a"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
